{
  "name": "fanqie-cli",
  "version": "0.1.0",
  "private": true,
  "description": "番茄小说命令行：搜索、书籍详情、目录、正文",
  "license": "AGPL-3.0-or-later",
  "bin": {
    "fanqie": "src/cli.ts"
  },
  "type": "module",
